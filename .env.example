# Copy to .env (local) or set these in Vercel -> Project Settings -> Environment Variables.
# Server-side only. Never commit real values.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN
# Enquiry-chat leads are emailed via Resend (primary). FROM must be on a domain verified in Resend.
RESEND_API_KEY=YOUR_RESEND_API_KEY
LEAD_EMAIL_FROM=SparkLab website <enquiries@wearesparklab.com>
LEAD_EMAIL_TO=support@wearesparklab.com
# Optional second route: n8n webhook (Gmail + Notion). Leave unset if n8n is down.
SPARKLAB_LEAD_WEBHOOK=YOUR_LEAD_WEBHOOK_URL
